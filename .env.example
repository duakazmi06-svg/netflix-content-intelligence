# Copy this file to .env and fill in ONE of the two keys.
# Get them free at https://www.themoviedb.org/settings/api
# Never commit .env — it is listed in .gitignore.

TMDB_API_KEY=your_v3_api_key_here
# TMDB_READ_TOKEN=your_v4_read_access_token_here

# Netflix catalog region (ISO country code): US, PK, GB, IN ...
TMDB_REGION=US
